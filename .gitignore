# Generated keypairs (security - never commit private keys).
# Keep these patterns specific. A blanket "*.json" rule here previously
# swallowed real project files (x402-facilitator/package.json and
# tsconfig.json), which left that subproject unbuildable once cloned.
keypair*.json
privatekey*.json
private_key*.json
mnemonic*.json
seed*.json

